# OpenAI API (VLM / STT / LLM Agent)
OPENAI_API_KEY=your_openai_api_key_here

# ROS 2 DDS settings
ROS_DOMAIN_ID=40
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Robot / Gripper network
ROBOT_HOST=192.168.1.100
ROBOT_MODEL=m0609
ROBOT_ID=dsr01
GRIPPER_IP=192.168.1.1
GRIPPER_PORT=502

# Remote teleoperation admin key (Tier 3)
REMOTE_ADMIN_KEY=change_me_remote_key
