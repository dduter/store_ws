<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>store_bringup</name>
  <version>0.1.0</version>
  <description>Unified launch files for 24h unmanned convenience store cobot</description>
  <maintainer email="team@store.cobot">Store Cobot Team</maintainer>
  <license>MIT</license>

  <exec_depend>store_interfaces</exec_depend>
  <exec_depend>store_vision</exec_depend>
  <exec_depend>store_llm_agent</exec_depend>
  <exec_depend>store_robot_control</exec_depend>
  <exec_depend>store_web_ui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
